{
  "manifest_version": 3,
  "name": "Lumi Download Manager",
  "version": "2.0.0",
  "description": "Browser capture surface for the local Lumi Runtime.",
  "key": "",
  "permissions": [
    "activeTab",
    "downloads",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:7000/*",
    "http://localhost:7000/*",
    "ws://127.0.0.1:7001/*",
    "ws://localhost:7001/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-v2.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_title": "Lumi DM",
    "default_popup": "popup.html"
  }
}
